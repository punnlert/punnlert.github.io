{
	"name": "sveltekit-static-blog-template",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint . && npm run lint:css",
		"lint:css": "stylelint \"src/**/*.{scss,css,svelte}\"",
		"format": "prettier --write .",
		"optimize-images": "image-transmutation --run --sourceFolder './build/images' --targetFolder './build/images' --inputFormats 'jpg' --inputFormats 'jpeg' --inputFormats 'png' --outputFormats 'webp' --outputFormats 'avif'",
		"postbuild": "npm run optimize-images && svelte-sitemap --domain https://punnlert.com/",
		"vercel-sitemap": "svelte-sitemap --out-dir .vercel/output/static --domain https://punnlert.com/",
		"vercel-optimize-images": "image-transmutation --run --sourceFolder '.vercel/output/static/images' --targetFolder '.vercel/output/static/images' --inputFormats 'jpg' --inputFormats 'jpeg' --inputFormats 'png' --outputFormats 'webp' --outputFormats 'avif'",
		"vercel-build": "npm run build && npm run vercel-sitemap && npm run vercel-optimize-images"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.507",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/gtag.js": "^0.0.20",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^26.2.0",
		"@typescript-eslint/parser": "^8.67.0",
		"dateformat": "^5.0.3",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.46.1",
		"image-transmutation": "^1.0.1",
		"mdsvex": "^0.12.8",
		"postcss-html": "^1.8.1",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^6.1.1",
		"rehype-external-links": "^2.0.1",
		"rehype-slug": "^5.1.0",
		"sass": "^1.57.1",
		"striptags": "^3.2.0",
		"stylelint": "^17.14.1",
		"stylelint-config-html": "^1.1.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^0.43.0",
		"svelte-lightbox": "^1.1.6",
		"svelte-sitemap": "^2.5.4",
		"typescript": "^5.9.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^6.3.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/eb-garamond": "^5.2.7",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/source-serif-4": "^5.2.9",
		"@fontsource/instrument-serif": "^5.2.8",
		"@fontsource/libre-caslon-condensed": "^5.2.5",
		"@fontsource/libre-caslon-display": "^5.2.7",
		"@fontsource/libre-caslon-text": "^5.2.7",
		"@fontsource/redaction": "^5.2.5",
		"@qwik.dev/partytown": "^0.11.2",
		"@splidejs/svelte-splide": "^0.2.9",
		"lenis": "^1.3.25",
		"matter-js": "^0.20.0",
		"svelte-youtube": "^0.0.2"
	},
	"overrides": {
		"svelte-youtube": {
			"svelte": "$svelte"
		}
	}
}
